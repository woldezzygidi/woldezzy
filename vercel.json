{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "installCommand": "npm ci --omit=dev --ignore-scripts",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/public/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ],
  "redirects": [
    { "source": "/blog", "destination": "/journal/", "permanent": true },
    { "source": "/blog/:path*", "destination": "/journal/", "permanent": true },
    { "source": "/feed", "destination": "/journal/", "permanent": true },
    { "source": "/feed/:path*", "destination": "/journal/", "permanent": true },
    { "source": "/west-midlands-seo", "destination": "/wolverhampton-birmingham-seo/", "permanent": true },
    { "source": "/wp-content/uploads/2025/07/UK_FMCG_Tech_Growth_Research_Oduwole_2025.pdf", "destination": "/public/papers/UK_FMCG_Tech_Growth_Research_Oduwole_2025.pdf", "permanent": true },
    { "source": "/wp-admin/:path*", "destination": "/", "permanent": true },
    { "source": "/wp-login.php", "destination": "/", "permanent": true },
    { "source": "/xmlrpc.php", "destination": "/", "permanent": true },
    { "source": "/wp-json/:path*", "destination": "/", "permanent": true },
    { "source": "/category/:path*", "destination": "/journal/", "permanent": true },
    { "source": "/tag/:path*", "destination": "/journal/", "permanent": true },
    { "source": "/author/:path*", "destination": "/about/", "permanent": true }
  ]
}
